# Local environment and IDE
.env
.env.*
origin.env
.idea/
__pycache__/
*.pyc

# Virtual envs
venv/

# Large/raw data (не коммитим исходные материалы и выгрузки)
processed_eda_data/
scraped_site/
dumped/
exports/

# Локальные снапшоты HF (python scripts/download_embedders.py)
DATA/hf_embedders/

# Misc
*.log
ml_service.db

# Кэши и служебные каталоги инструментов
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
.claude/

# Локальная Chroma / блокировки (не коммитить персист и лок)
DATA/chromadb_persist/
DATA/eval_gpu.lock

# Воспроизводимые прогоны retrieval/answer-eval (артефакты регенерируются)
eval/runs/**
# ...but keep small run summaries (paper evidence): json/md/csv, no raw traces (*.jsonl/*.txt)
!eval/runs/**/
!eval/runs/**/*.json
!eval/runs/**/*.md
!eval/runs/**/*.csv
# full environment dumps must never be committed
eval/runs/**/env_snapshot.json

# Файловые архивы и упаковки (не путать с каталогом archive/ в корне репо)
*.zip
*.rar
*.7z
*.tar
*.tar.gz

# Исторический код и скрипты в archive/ (не тянуть в индекс по умолчанию)
archive/

# Локальный справочник для агента (расширяется без обязательного коммита)
docs/AGENT_RAG_STACK.md

# Large corpus snapshots / indexes (size + foundation content; kept on backup disk with sha256)
DATA/indexes/
DATA/runs/corpus_full_export_*/

# Scratch output and local helper state
_temp_pg_out.txt
scripts/_chat_id.txt

# Personal IDE plans
.cursor/plans/
